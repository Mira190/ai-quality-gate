{
  "name": "ai-quality-gate",
  "version": "1.0.0",
  "private": true,
  "description": "Pull-request quality gate: are requirements and design decisions proven by tests, are tests at the right level, does CI enforce its checks. Deterministic rules first, a model only for what code cannot decide.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "aqg": "bin/aqg.js"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-exclude=\"tests/**\" \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "gate": "node bin/aqg.js run --repo ."
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
